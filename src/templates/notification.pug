doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
  body(style="margin:0;padding:0;font-family:Arial,sans-serif;background:#fff;color:#333")
