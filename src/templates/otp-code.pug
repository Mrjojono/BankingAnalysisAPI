doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Code OTP
    style.
      body {
        margin: 0;
        padding: 20px;
        background-color: #fff;
        font-family: Arial, sans-serif;
        color: #333;
      }
      .container {
        max-width: 400px;
        margin: 0 auto;
        text-align: center;
      }
      .otp-code {
        font-size: 36px;
        font-weight: bold;
        letter-spacing: 6px;
        margin: 30px 0;
        font-family: 'Courier New', monospace;
      }

  body
    .container
      p Votre code de vérification :

      .otp-code= otpCode

      p(style="font-size: 12px; color: #999;") Ce code expirera dans 5 minutes.
