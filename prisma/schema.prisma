generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum UserAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  EXPIRED
  REQUIRES_UPDATE
  LIMITED
}

enum AccountType {
  CHECKING
  SAVINGS
  LOAN
  CORPORATE
  MOBILE_MONEY
}

enum GLAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum BalanceType {
  DEBIT
  CREDIT
}

enum JournalType {
  GENERAL
  SALES
  PURCHASES
  CASH
  BANK
}

enum JournalStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum TransactionType {
  INTERNAL_TRANSFER
  DEPOSIT
  WITHDRAWAL
  MERCHANT_PAYMENT
  INTERNATIONAL_WIRE
  FEE
  INTEREST
  REVERSAL
}

enum TransactionStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
  CANCELLED
}

enum Direction {
  DEBIT
  CREDIT
}

enum Currency {
  XOF
  EUR
  USD
  GBP
}

enum OtpType {
  LOGIN
  TRANSACTION
  RESET_PASSWORD
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  ACCOUNT_ACTIVATION
}

enum MfaMethod {
  TOTP
  SMS
  EMAIL
}

enum UserBankConnectionRole {
  OWNER
  DELEGATE
  VIEWER
}

enum NotificationType {
  ADVICE
  SCORE_CHANGE
  ELIGIBILITY
  EDUCATIONAL
  SYSTEM
  ADMIN_BROADCAST
  WEEKLY_DIGEST
  LESSON_RECOMMENDED
  PATH_COMPLETED
}

enum NotificationChannel {
  PUSH
  IN_APP
  EMAIL
}

model User {
  id       String  @id @default(uuid()) @db.Uuid
  email    String  @unique
  password String?

  role   Role               @default(CLIENT)
  status UserAccountStatus  @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  loginCount      Int       @default(0)

  mfaEnabled  Boolean @default(false)
  mfaSecret   String?
  backupCodes String?

  sessions    Session[]
  otpCodes    OtpCode[]
  mfaAttempts MFAAttempt[]
  authLogs    AuthLog[]

  bankConnections UserBankConnection[]

  pushTokens             PushToken[]
  notifications          Notification[]
  notificationPreference NotificationPreference?

  pathProgress   UserPathProgress[]
  lessonProgress UserLessonProgress[]
  quizAttempts   QuizAttempt[]
  savingsGoals   SavingsGoal[]
  dismissedItems DismissedItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@map("users")
}

model Session {
  id     String @id @default(cuid())
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime

  userAgent String?
  ipAddress String?

  deviceFingerprint String?
  geoLocation       Json?

  isRevoked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model MFAAttempt {
  id     String @id @default(cuid())
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  method  MfaMethod
  success Boolean

  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("mfa_attempts")
}

model OtpCode {
  id     String @id @default(cuid())
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code String
  type OtpType

  expiresAt DateTime
  usedAt    DateTime?

  attempts Int @default(0)

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@map("otp_codes")
}

model AuthLog {
  id String @id @default(cuid())

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email   String?
  action  String
  success Boolean

  ipAddress String?
  userAgent String?

  deviceFingerprint String?
  geoLocation       Json?
  riskScore         Int?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("auth_logs")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  data      Json?
  severity  String?
  link      String?
  isRead    Boolean             @default(false)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @unique @db.Uuid
  push   Boolean @default(true)
  email  Boolean @default(false)
  types  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_prefs")
}

model ScheduledNotification {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  body        String
  type        String   @default("ADMIN_BROADCAST")
  severity    String   @default("INFO")

  scheduledAt DateTime
  recurrence  String?  // DAILY | WEEKLY | MONTHLY | null = one-shot
  lastSentAt  DateTime?
  active      Boolean  @default(true)

  targetType  String   @default("all")   // all | user_ids | customer_targets
  targetIds   Json?                       // array of userIds or customer emails/IDs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, scheduledAt])
  @@map("scheduled_notifications")
}

model BankCustomer {
  id String @id @default(uuid()) @db.Uuid

  email     String
  firstName String
  lastName  String?
  telephone String

  accountNumber String @unique
  customerCode  String @unique

  kycStatus     KycStatus @default(PENDING)
  kycVerifiedAt DateTime?
  kycDocuments  Json?

  accounts      BankAccount[]
  beneficiaries Beneficiary[]

  smsTransactions      SmsTransaction[]

  sentTransactions     Transaction[] @relation("SenderCustomer")
  receivedTransactions Transaction[] @relation("ReceiverCustomer")

  userConnection UserBankConnection?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountNumber])
  @@index([email])
  @@index([telephone])
  @@map("bank_customers")
}

model BankAccount {
  id String @id @default(uuid()) @db.Uuid

  customerId String       @db.Uuid
  customer   BankCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  accountId String  @unique @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  iban String? @unique

  accountType AccountType @default(CHECKING)
  currency    Currency    @default(XOF)

  isActive  Boolean @default(true)
  isBlocked Boolean @default(false)

  blockedReason String?

  dailyLimit   BigInt @default(500000)
  monthlyLimit BigInt @default(5000000)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@map("bank_accounts")
}

model Beneficiary {
  id String @id @default(uuid()) @db.Uuid

  customerId String       @db.Uuid
  customer   BankCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name          String
  accountNumber String

  bankName String?
  bankCode String?

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("beneficiaries")
}

model UserBankConnection {
  id String @id @default(cuid())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankCustomerId String       @unique @db.Uuid
  bankCustomer   BankCustomer @relation(fields: [bankCustomerId], references: [id], onDelete: Cascade)

  role UserBankConnectionRole @default(OWNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bankCustomerId])
  @@index([userId])
  @@index([bankCustomerId])
  @@map("user_bank_connections")
}

model Ledger {
  id String @id @default(uuid()) @db.Uuid

  code String @unique @db.VarChar(50)
  name String @db.VarChar(100)

  description String?
  metadata    Json?

  journals     Journal[]
  accounts     Account[]
  transactions Transaction[]
  entries      Entry[]
  tranCodes    TranCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ledgers")
}

model Journal {
  id String @id @default(uuid()) @db.Uuid

  code String @db.VarChar(50)
  name String @db.VarChar(100)

  description String?

  status      JournalStatus @default(ACTIVE)
  journalType JournalType

  metadata Json?

  ledgerId String @db.Uuid
  ledger   Ledger @relation(fields: [ledgerId], references: [id])

  transactions Transaction[]
  entries      Entry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ledgerId])
  @@map("journals")
}

model Account {
  id String @id @default(uuid()) @db.Uuid

  code String @db.VarChar(50)
  name String @db.VarChar(100)

  description String?

  glAccountType GLAccountType
  balanceType   BalanceType

  currency Currency @default(XOF)

  settledDebit  BigInt @default(0)
  settledCredit BigInt @default(0)

  pendingDebit  BigInt @default(0)
  pendingCredit BigInt @default(0)

  availableDebit  BigInt @default(0)
  availableCredit BigInt @default(0)

  metadata Json?

  version Int @default(0)

  ledgerId String @db.Uuid
  ledger   Ledger @relation(fields: [ledgerId], references: [id])

  bankAccount BankAccount?
  entries     Entry[]
  snapshots   AccountBalanceSnapshot[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([code, ledgerId])
  @@index([ledgerId])
  @@index([code])
  @@map("accounts")
}

model AccountBalanceSnapshot {
  id String @id @default(uuid()) @db.Uuid

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  settledBalance   BigInt
  pendingBalance   BigInt
  availableBalance BigInt

  snapshotDate DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([snapshotDate])
  @@map("account_balance_snapshots")
}

model Transaction {
  id String @id @default(uuid()) @db.Uuid

  description String?

  externalTransactionId String? @db.VarChar(100)

  transactionType TransactionType
  status          TransactionStatus @default(PENDING)

  amount   BigInt
  currency Currency @default(XOF)

  transactionDate DateTime  @default(now())
  effectiveAt     DateTime?
  postedAt        DateTime?

  network           String?
  clearingReference String?
  settlementBatchId String?

  deviceFingerprint String?
  geoLocation       Json?
  riskScore         Int?

  reversedByTransactionId String? @unique @db.Uuid
  reversesTransactionId   String? @db.Uuid

  reversedByTransaction Transaction? @relation("Reversal", fields: [reversedByTransactionId], references: [id])
  reversesTransaction   Transaction? @relation("Reversal")

  journalId String  @db.Uuid
  journal   Journal @relation(fields: [journalId], references: [id])

  ledgerId String @db.Uuid
  ledger   Ledger @relation(fields: [ledgerId], references: [id])

  tranCodeId String?   @db.Uuid
  tranCode   TranCode? @relation(fields: [tranCodeId], references: [id])

  senderCustomerId String?       @db.Uuid
  senderCustomer   BankCustomer? @relation("SenderCustomer", fields: [senderCustomerId], references: [id])

  receiverCustomerId String?       @db.Uuid
  receiverCustomer   BankCustomer? @relation("ReceiverCustomer", fields: [receiverCustomerId], references: [id])

  metadata Json?

  version Int @default(0)

  entries Entry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journalId])
  @@index([ledgerId])
  @@index([status])
  @@index([transactionDate])
  @@index([senderCustomerId])
  @@index([receiverCustomerId])
  @@map("transactions")
}

model Entry {
  id String @id @default(uuid()) @db.Uuid

  direction Direction

  amount   BigInt
  currency Currency @default(XOF)

  sequence Int

  accountVersion Int @default(0)
  version        Int @default(0)

  metadata Json?

  transactionId String      @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  journalId String  @db.Uuid
  journal   Journal @relation(fields: [journalId], references: [id])

  ledgerId String @db.Uuid
  ledger   Ledger @relation(fields: [ledgerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([accountId])
  @@map("entries")
}

model TranCode {
  id String @id @default(uuid()) @db.Uuid

  code        String  @db.VarChar(50)
  description String?

  details Json?

  ledgerId String @db.Uuid
  ledger   Ledger @relation(fields: [ledgerId], references: [id])

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ledgerId])
  @@map("tran_codes")
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  entityType String
  entityId   String

  action String

  actorId   String? @db.Uuid
  actorRole Role?

  before Json?
  after  Json?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

//produit bancaire et regles metier

model BankProduct {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  reference   String?

  category String? // ex: ACCOUNT, CARD, LOAN, PAYMENT, BANKING, DIGITAL, INTERNATIONAL, LOAN, MISC, FOREX, INCIDENT

  conditions Json? // variantes / métadonnées (ex: paliers de cartes Visa)

  isActive Boolean @default(true)

  rules         Rule[]
  linkedLessons Lesson[] @relation("ProductLessons")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bank_products")
}

model Rule {
  id String @id @default(uuid()) @db.Uuid

  productId String?      @db.Uuid
  product   BankProduct? @relation(fields: [productId], references: [id])

  code        String
  label       String
  description String?

  type RuleType

  field String

  operator RuleOperator?

  value    Float?
  valueMin Float?
  valueMax Float?

  percentage Float?
  flatAmount Float?
  minAmount  Float?
  maxAmount  Float?

  currency Currency?

  period RulePeriod?

  conditions Json?

  weight   Int @default(0)
  priority Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, code])
  @@index([productId])
  @@index([type])
  @@map("rules")
}

enum SmsTransactionStatus {
  PENDING
  APPROVED
  IGNORED
}

model SmsTransaction {
  id         Int          @id @default(autoincrement())
  customerId String       @db.Uuid
  smsId      Int
  address    String
  body       String
  amount     Int?
  direction  String?
  operator   String?
  sender     String?
  dateSent   DateTime
  createdAt  DateTime     @default(now())

  status       SmsTransactionStatus @default(PENDING)
  category     String?
  cbCategory   String?
  cbConfidence Float?
  arbitration  String?
  disagreed    Boolean @default(false)
  counterparty String?
  balanceAfter Float?
  referenceNo  String?
  confidence   Float?
  fingerprint  String?              @unique
  reviewedAt   DateTime?
  reviewedBy   String?
  matchRuleId  String?              @db.Uuid
  matchRule    SmsFilterRule?       @relation(fields: [matchRuleId], references: [id])

  customer BankCustomer @relation(fields: [customerId], references: [id])

  @@unique([customerId, smsId])
  @@index([customerId])
  @@index([status])
  @@index([operator])
  @@index([matchRuleId])
  @@map("sms_transactions")
}

model SmsFilterRule {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String?  @db.Uuid
  operator    String?
  address     String?
  keyword     String?
  direction   String?
  action      String   @default("IGNORE")
  description String?
  isActive    Boolean  @default(true)

  transactions SmsTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([isActive])
  @@map("sms_filter_rules")
}

// ============================================================
// EDUCATION
// ============================================================

enum LessonDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LearningPath {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  description String?
  icon        String?
  difficulty  LessonDifficulty
  order       Int              @default(0)
  isActive    Boolean          @default(true)

  lessons  Lesson[]
  progress UserPathProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("learning_paths")
}

model Lesson {
  id               String           @id @default(uuid()) @db.Uuid
  learningPathId   String           @db.Uuid
  title            String
  content          String // Markdown (fallback)
  contentBlocks    Json?
  summary          String?
  imageUrl         String?
  videoUrl         String?
  difficulty       LessonDifficulty
  order            Int              @default(0)
  estimatedMinutes Int?
  status           LessonStatus     @default(DRAFT)
  minScore         Int?
  maxScore         Int?
  relatedProductId String?          @db.Uuid

  learningPath   LearningPath         @relation(fields: [learningPathId], references: [id])
  relatedProduct BankProduct?         @relation("ProductLessons", fields: [relatedProductId], references: [id])
  adviceLinks    LessonAdviceLink[]
  progress       UserLessonProgress[]
  quizLinks      QuizLessonLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([learningPathId])
  @@index([minScore, maxScore])
  @@index([status])
  @@map("lessons")
}

model LessonAdviceLink {
  id         String @id @default(uuid()) @db.Uuid
  lessonId   String @db.Uuid
  adviceType String
  priority   Int    @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, adviceType])
  @@index([adviceType])
  @@map("lesson_advice_links")
}

model UserPathProgress {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  learningPathId   String    @db.Uuid
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  lessonsCompleted Int       @default(0)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@unique([userId, learningPathId])
  @@map("user_path_progress")
}

model UserLessonProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  lessonId    String    @db.Uuid
  completed   Boolean   @default(false)
  completedAt DateTime?
  viewedAt    DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_lesson_progress")
}

enum RuleType {
  ELIGIBILITY
  LIMIT
  FEE
  VALUE_DATE
  INTEREST
}

// ========== Quiz ==========

enum QuizQuestionType {
  MCQ
  TRUE_FALSE
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Quiz {
  id           String     @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  status       QuizStatus @default(DRAFT)
  passingScore Int        @default(70)

  questions   QuizQuestion[]
  lessonLinks QuizLessonLink[]
  attempts    QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quizzes")
}

model QuizQuestion {
  id          String           @id @default(uuid()) @db.Uuid
  quizId      String           @db.Uuid
  question    String
  type        QuizQuestionType @default(MCQ)
  category    String?
  explanation String?
  order       Int              @default(0)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices QuizChoice[]
  answers QuizAnswer[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizChoice {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@index([questionId])
  @@map("quiz_choices")
}

model QuizLessonLink {
  id       String @id @default(uuid()) @db.Uuid
  quizId   String @db.Uuid
  lessonId String @db.Uuid

  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([quizId, lessonId])
  @@map("quiz_lesson_links")
}

model QuizAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  quizId      String    @db.Uuid
  score       Int
  total       Int
  passed      Boolean
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([userId, quizId])
  @@map("quiz_attempts")
}

model SavingsGoal {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  name         String
  targetAmount Float
  savedAmount  Float    @default(0)
  targetDate   DateTime
  status       String   @default("ACTIVE")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("savings_goals")
}

model DismissedItem {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  fingerprint String
  kind        String   @default("ADVICE")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("dismissed_items")
}

model QuizAnswer {
  id         String  @id @default(uuid()) @db.Uuid
  attemptId  String  @db.Uuid
  questionId String  @db.Uuid
  choiceId   String  @db.Uuid
  isCorrect  Boolean

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id])
  choice   QuizChoice   @relation(fields: [choiceId], references: [id])

  @@index([attemptId])
  @@map("quiz_answers")
}

enum RulePeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
